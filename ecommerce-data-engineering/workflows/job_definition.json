{
  "name": "ecommerce-medallion-etl-pipeline",
  "description": "End-to-end Medallion Lakehouse workflow for E-Commerce Customer Behaviour & Sales Intelligence (Olist dataset): Bronze ingestion -> Silver cleaning -> Gold aggregations -> Data Quality gate.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "tags": {
    "project": "ecommerce-sales-intelligence",
    "architecture": "medallion",
    "owner": "data-engineering",
    "dataset": "olist-brazilian-ecommerce"
  },
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "email_notifications": {
    "on_failure": [
      "data-engineering-alerts@example.com"
    ],
    "on_success": [],
    "no_alert_for_skipped_runs": true
  },
  "job_clusters": [
    {
      "job_cluster_key": "ecommerce_etl_cluster",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "data_security_mode": "USER_ISOLATION",
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true"
        },
        "custom_tags": {
          "project": "ecommerce-sales-intelligence",
          "environment": "production"
        }
      }
    }
  ],
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "description": "Ingest all 9 raw Olist CSV files from Unity Catalog Volume into Bronze Delta tables with explicit schemas and audit columns.",
      "job_cluster_key": "ecommerce_etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/ecommerce-data-engineering/notebooks/01_bronze_ingestion",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 30000,
      "timeout_seconds": 900
    },
    {
      "task_key": "silver_cleaning",
      "description": "Clean, cast, deduplicate, translate product categories, pre-aggregate payments, and build silver_orders_enriched and silver_orders_non_delivered.",
      "depends_on": [
        {
          "task_key": "bronze_ingestion"
        }
      ],
      "job_cluster_key": "ecommerce_etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/ecommerce-data-engineering/notebooks/03_silver_cleaning",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 30000,
      "timeout_seconds": 1200
    },
    {
      "task_key": "gold_aggregations",
      "description": "Compute 9 Gold analytical Delta tables including daily/monthly sales, category performance, RFM segmentation, delivery SLAs, payment mix, sellers, and review vs delay.",
      "depends_on": [
        {
          "task_key": "silver_cleaning"
        }
      ],
      "job_cluster_key": "ecommerce_etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/ecommerce-data-engineering/notebooks/04_gold_aggregations",
        "source": "WORKSPACE"
      },
      "max_retries": 2,
      "min_retry_interval_millis": 30000,
      "timeout_seconds": 900
    },
    {
      "task_key": "data_quality_checks",
      "description": "Run automated PASS/FAIL data quality gate validating PK nulls, uniqueness, Silver-to-Gold revenue reconciliation, non-negative prices, and delivery date integrity.",
      "depends_on": [
        {
          "task_key": "gold_aggregations"
        }
      ],
      "job_cluster_key": "ecommerce_etl_cluster",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/ecommerce-data-engineering/notebooks/05_data_quality_checks",
        "source": "WORKSPACE"
      },
      "max_retries": 0,
      "timeout_seconds": 600
    }
  ],
  "format": "MULTI_TASK"
}
